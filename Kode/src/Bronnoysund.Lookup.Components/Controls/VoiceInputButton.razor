@inject ISpeechToText SpeechToText
@inject IStringLocalizer<SharedResources> L

@if (SpeechToText.IsAvailable)
{
    <MudTooltip Text="@L["VoiceInputTooltip"]" Placement="Placement.Top">
        <MudIconButton Icon="@MicIcon"
                       Color="@MicColor"
                       Disabled="@Disabled"
                       OnClick="OnMicClicked"
                       Class="@(_isListening ? "voice-input-listening" : null)"
                       Size="Size.Medium" />
    </MudTooltip>
}

<style>
    .voice-input-listening {
        animation: voice-pulse 1.1s ease-in-out infinite;
    }

    @@keyframes voice-pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.18); opacity: 0.7; }
    }
</style>

@code {
    /// <summary>Recognized text that parses as an org-number. Caller fires the lookup.</summary>
    [Parameter] public EventCallback<string> OnOrgNumberRecognized { get; set; }

    /// <summary>Recognized text that did NOT parse as an org-number — treat as a name query.</summary>
    [Parameter] public EventCallback<string> OnNameRecognized { get; set; }

    /// <summary>Non-blocking error message shown when recognition returned nothing useful.</summary>
    [Parameter] public EventCallback<string> OnRecognitionFailed { get; set; }

    /// <summary>Forward the outer "is the form busy" state so we don't allow concurrent listens.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>BCP-47 culture passed to the recognizer. Defaults to nb-NO.</summary>
    [Parameter] public string LanguageCode { get; set; } = "nb-NO";

    private bool _isListening;

    private string MicIcon => _isListening
        ? Icons.Material.Filled.MicNone
        : Icons.Material.Filled.Mic;

    private Color MicColor => _isListening ? Color.Secondary : Color.Primary;

    private async Task OnMicClicked()
    {
        if (_isListening) return;
        _isListening = true;
        try
        {
            var transcript = await SpeechToText.ListenAsync(LanguageCode, CancellationToken.None);
            if (string.IsNullOrWhiteSpace(transcript))
            {
                await OnRecognitionFailed.InvokeAsync(L["VoiceRecognitionFailed"].Value);
                return;
            }

            // Try to read the transcript as a digit-by-digit org number first; only fall back
            // to a name search if every token failed to parse as a digit. This keeps the
            // org-number path (the most common case for this app) cheap and predictable.
            if (NorskTallParser.TryParseDigits(transcript, out var digits) && digits.Length == 9)
            {
                await OnOrgNumberRecognized.InvokeAsync(digits);
            }
            else
            {
                await OnNameRecognized.InvokeAsync(transcript);
            }
        }
        finally
        {
            _isListening = false;
        }
    }
}
