@using Bronnoysund.Application.Ports
@using Bronnoysund.BlazorWeb.Adapters
@inject IDeviceLayout Layout
@inject IJSRuntime JS

@code {
    // Headless component placed once in MainLayout. On first interactive render it asks the JS
    // shim to start reporting viewport-bucket changes back to the scoped WebDeviceLayout. Pages
    // can then read Layout.Current synchronously without each one needing to repeat the wiring.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (Layout is WebDeviceLayout web)
        {
            await web.InitializeAsync(JS);
        }
    }
}
