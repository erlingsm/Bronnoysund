@page "/settings"
@using System.Globalization
@inject ISettingsRepository SettingsRepo
@inject ISettingsBackup Backup
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["SettingsTitle"] — @L["AppTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["SettingsTitle"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">@L["SettingsDescription"]</MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Label="@L["UiCultureLabel"]" Value="@_currentCulture"
                           ValueChanged="OnCultureChangedAsync" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem Value="@("en")">@L["LanguageEnglish"]</MudSelectItem>
                    <MudSelectItem Value="@("nb-NO")">@L["LanguageNorwegianBokmal"]</MudSelectItem>
                    <MudSelectItem Value="@("nn-NO")">@L["LanguageNorwegianNynorsk"]</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudToolBar Dense="true" Gutters="false" Class="mb-2">
            <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                       OnClick="OnAddClicked">@L["AddKey"]</MudButton>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Download" OnClick="OnExportClicked">@L["Export"]</MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Upload" OnClick="OnImportOpenClicked">@L["Import"]</MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.RestartAlt" Color="Color.Warning"
                       OnClick="OnResetClicked">@L["Reset"]</MudButton>
        </MudToolBar>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_settings.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="my-2">@L["NoSettings"]</MudAlert>
        }
        else
        {
            <MudTable Items="@_settings" Dense="true" Hover="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>@L["KeyCol"]</MudTh>
                    <MudTh>@L["ValueCol"]</MudTh>
                    <MudTh>@L["TypeCol"]</MudTh>
                    <MudTh Style="width: 1%">@L["ActionsCol"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="row">
                    <MudTd DataLabel="@L["KeyCol"]"><code>@row.Key</code></MudTd>
                    <MudTd DataLabel="@L["ValueCol"]">
                        <MudTextField @bind-Value="row.EditedValue" Variant="Variant.Text" Margin="Margin.Dense" />
                    </MudTd>
                    <MudTd DataLabel="@L["TypeCol"]">@row.DataType</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Primary"
                                       Disabled="@(row.EditedValue == row.OriginalValue)"
                                       OnClick="@(() => SaveRowAsync(row))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteRowAsync(row))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@if (_addOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudPaper Class="pa-4" Style="width: 480px; max-width: 90vw;">
            <MudText Typo="Typo.h6" GutterBottom="true">@L["NewSettingTitle"]</MudText>
            <MudTextField @bind-Value="_newKey" Label="@L["KeyLabel"]" Variant="Variant.Outlined" Class="mb-2"
                          Placeholder="@L["KeyPlaceholder"]" />
            <MudTextField @bind-Value="_newValue" Label="@L["ValueLabel"]" Variant="Variant.Outlined" Class="mb-2" />
            <MudSelect @bind-Value="_newDataType" Label="@L["TypeLabel"]" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem Value="@("string")">string</MudSelectItem>
                <MudSelectItem Value="@("int")">int</MudSelectItem>
                <MudSelectItem Value="@("bool")">bool</MudSelectItem>
                <MudSelectItem Value="@("double")">double</MudSelectItem>
                <MudSelectItem Value="@("timespan")">timespan</MudSelectItem>
            </MudSelect>
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton OnClick="@(() => _addOpen = false)">@L["Cancel"]</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnAddConfirmedAsync">@L["Add"]</MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@if (_exportOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudPaper Class="pa-4" Style="width: 640px; max-width: 95vw;">
            <MudText Typo="Typo.h6" GutterBottom="true">@L["ExportTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@L["ExportDescription"]</MudText>
            <MudTextField @bind-Value="_exportJson" Lines="14" Variant="Variant.Outlined" ReadOnly="true" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                <MudButton OnClick="@(() => _exportOpen = false)">@L["Close"]</MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@if (_importOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" Absolute="false">
        <MudPaper Class="pa-4" Style="width: 640px; max-width: 95vw;">
            <MudText Typo="Typo.h6" GutterBottom="true">@L["ImportTitle"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@L["ImportDescription"]</MudText>
            <MudTextField @bind-Value="_importJson" Lines="14" Variant="Variant.Outlined" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                <MudButton OnClick="@(() => _importOpen = false)">@L["Cancel"]</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnImportConfirmedAsync">@L["Import"]</MudButton>
            </MudStack>
        </MudPaper>
    </MudOverlay>
}

@code {
    private const string CultureSettingKey = "UI:Culture";

    private sealed class SettingRow
    {
        public required string Key { get; init; }
        public required string OriginalValue { get; set; }
        public string EditedValue { get; set; } = "";
        public required string DataType { get; init; }
    }

    private bool _loading = true;
    private List<SettingRow> _settings = [];
    private string _currentCulture = "en";

    private bool _addOpen;
    private string _newKey = "";
    private string _newValue = "";
    private string _newDataType = "string";

    private bool _exportOpen;
    private string _exportJson = "";

    private bool _importOpen;
    private string _importJson = "";

    protected override async Task OnInitializedAsync()
    {
        _currentCulture = CultureInfo.CurrentUICulture.Name switch
        {
            "nb-NO" or "nb" => "nb-NO",
            "nn-NO" or "nn" => "nn-NO",
            _ => "en",
        };
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var all = await SettingsRepo.GetAllAsync(default);
        _settings = all
            .Where(s => s.Key != CultureSettingKey)
            .Select(s => new SettingRow
            {
                Key = s.Key,
                OriginalValue = s.Value,
                EditedValue = s.Value,
                DataType = s.DataType,
            }).ToList();
        _loading = false;
    }

    private async Task SaveRowAsync(SettingRow row)
    {
        await SettingsRepo.SetAsync(row.Key, row.EditedValue, row.DataType, default);
        row.OriginalValue = row.EditedValue;
        Snackbar.Add(L["Saved", row.Key], Severity.Success);
    }

    private async Task DeleteRowAsync(SettingRow row)
    {
        await SettingsRepo.RemoveAsync(row.Key, default);
        _settings.Remove(row);
        Snackbar.Add(L["Deleted", row.Key], Severity.Info);
    }

    private void OnAddClicked()
    {
        _newKey = "";
        _newValue = "";
        _newDataType = "string";
        _addOpen = true;
    }

    private async Task OnAddConfirmedAsync()
    {
        if (string.IsNullOrWhiteSpace(_newKey))
        {
            Snackbar.Add(L["KeyEmpty"], Severity.Warning);
            return;
        }
        await SettingsRepo.SetAsync(_newKey, _newValue, _newDataType, default);
        _addOpen = false;
        await LoadAsync();
        Snackbar.Add(L["Added", _newKey], Severity.Success);
    }

    private async Task OnExportClicked()
    {
        _exportJson = await Backup.ExportAsync(default);
        _exportOpen = true;
    }

    private void OnImportOpenClicked()
    {
        _importJson = "";
        _importOpen = true;
    }

    private async Task OnImportConfirmedAsync()
    {
        try
        {
            await Backup.ImportAsync(_importJson, default);
            _importOpen = false;
            await LoadAsync();
            Snackbar.Add(L["Imported"], Severity.Success);
        }
        catch (InvalidSettingsBackupException ex)
        {
            Snackbar.Add(L["ImportFailed", ex.Message], Severity.Error);
        }
    }

    private async Task OnResetClicked()
    {
        foreach (var row in _settings.ToList())
        {
            await SettingsRepo.RemoveAsync(row.Key, default);
        }
        _settings.Clear();
        Snackbar.Add(L["AllRemoved"], Severity.Info);
    }

    private async Task OnCultureChangedAsync(string newCulture)
    {
        _currentCulture = newCulture;
        await SettingsRepo.SetAsync(CultureSettingKey, newCulture, "string", default);

        var ci = new CultureInfo(newCulture);
        CultureInfo.DefaultThreadCurrentCulture = ci;
        CultureInfo.DefaultThreadCurrentUICulture = ci;
        CultureInfo.CurrentCulture = ci;
        CultureInfo.CurrentUICulture = ci;

        StateHasChanged();
    }
}
