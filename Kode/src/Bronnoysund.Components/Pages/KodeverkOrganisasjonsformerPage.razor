@page "/kodeverk/organisasjonsformer"
@using Bronnoysund.Application.Results
@inject IKodeverkProvider Kodeverk
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NavKodeverkOrgForms"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["NavKodeverkOrgForms"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        @L["OrgFormsDescription"]
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@_error</MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="2">
        <div class="d-flex align-center mb-4" style="gap: 0.75rem; flex-wrap: wrap;">
            @* Toggle reuses Brreg's two filtered endpoints (med-enheter / med-underenheter)
               instead of running a client-side filter — Brreg's lists already reflect "in use"
               better than we could derive from the full list, and the 24h cache makes the
               extra round-trip free in steady state. *@
            <MudToggleGroup T="OrgFormsFilter" SelectionMode="SelectionMode.SingleSelection"
                            Value="_filterMode" ValueChanged="OnFilterChanged">
                <MudToggleItem Value="OrgFormsFilter.All">@L["OrgFormsFilterAll"]</MudToggleItem>
                <MudToggleItem Value="OrgFormsFilter.WithEntities">@L["OrgFormsFilterWithEntities"]</MudToggleItem>
                <MudToggleItem Value="OrgFormsFilter.WithSubUnits">@L["OrgFormsFilterWithSubUnits"]</MudToggleItem>
            </MudToggleGroup>
        </div>

        <MudTable Items="@_rows" Loading="@_loading" Dense="true" Hover="true"
                  Filter="new Func<KodeverkEntry, bool>(FilterRow)"
                  OnRowClick="OnRowClick"
                  T="KodeverkEntry">
            <ToolBarContent>
                <MudTextField @bind-Value="_filter" Placeholder="@L["FilterPlaceholder"]"
                              Variant="Variant.Outlined" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.FilterList" Margin="Margin.Dense"
                              Clearable="true" Immediate="true" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@L["KodeCol"]</MudTh>
                <MudTh>@L["BeskrivelseCol"]</MudTh>
                <MudTh>@L["StatusCol"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="row">
                <MudTd><code>@row.Code</code></MudTd>
                <MudTd>@row.Description</MudTd>
                <MudTd>
                    @if (row.IsRetired)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                            @L["StatusRetired"]
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">
                            @L["StatusActive"]
                        </MudChip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@L["NoResults"]</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private IReadOnlyList<KodeverkEntry> _rows = [];
    private bool _loading = true;
    private string? _error;
    private string _filter = string.Empty;
    private OrgFormsFilter _filterMode = OrgFormsFilter.All;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task OnFilterChanged(OrgFormsFilter mode)
    {
        _filterMode = mode;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = _filterMode switch
            {
                OrgFormsFilter.WithEntities => await Kodeverk.GetOrganisasjonsformerWithEnheterAsync(CancellationToken.None),
                OrgFormsFilter.WithSubUnits => await Kodeverk.GetOrganisasjonsformerWithUnderenheterAsync(CancellationToken.None),
                _ => await Kodeverk.GetOrganisasjonsformerAsync(CancellationToken.None),
            };
            switch (result)
            {
                case KodeverkLookupResult.Found f:
                    _rows = f.Entries;
                    break;
                case KodeverkLookupResult.Unavailable u:
                    _error = u.Message;
                    _rows = [];
                    break;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private bool FilterRow(KodeverkEntry e)
    {
        if (string.IsNullOrWhiteSpace(_filter)) return true;
        return e.Code.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || e.Description.Contains(_filter, StringComparison.OrdinalIgnoreCase);
    }

    private void OnRowClick(TableRowClickEventArgs<KodeverkEntry> args)
    {
        if (args.Item is { } row)
        {
            Nav.NavigateTo($"kodeverk/organisasjonsformer/{Uri.EscapeDataString(row.Code)}");
        }
    }

    private enum OrgFormsFilter
    {
        All,
        WithEntities,
        WithSubUnits,
    }
}
