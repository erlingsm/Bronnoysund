    private async Task OnReadAloud(CompanyResponse c)
    {
        var text = BuildSpeechText(c);
        await TextToSpeech.SpeakAsync(text, CultureInfo.CurrentUICulture.Name, CancellationToken.None);
    }

    /// <summary>
    /// Build the spoken summary for the read-aloud button. Org-numbers are spelled
    /// digit-by-digit because long Norwegian numbers ("nittisju millioner...") are hard
    /// to follow when read fast by TTS. Industry description is included only when present
    /// so we don't say "industry unknown" — silence is friendlier than a literal null read-out.
    /// </summary>
    private string BuildSpeechText(CompanyResponse c)
    {
        var orgnrSpoken = string.Join(" ", c.OrganizationNumber.Select(ch => ch.ToString()));
        var parts = new List<string>
        {
            c.OrganizationName,
            L["ReadAloudOrgNumber", orgnrSpoken].Value,
            L["ReadAloudOrgForm", c.CompanyType].Value,
        };
        if (c.PrimaryIndustry is { } industry)
        {
            parts.Add(L["ReadAloudIndustry", industry.Description].Value);
        }
        if (c.EmployeeCount is { } emp)
        {
            parts.Add(L["ReadAloudEmployees", emp].Value);
        }
        return string.Join(". ", parts) + ".";
    }

    private static bool HasContact(CompanyResponse c) =>
        c.BusinessAddress is not null
        || !string.IsNullOrWhiteSpace(c.Website)
        || !string.IsNullOrWhiteSpace(c.Email)
        || !string.IsNullOrWhiteSpace(c.Phone)
        || !string.IsNullOrWhiteSpace(c.MobilePhone);

    private static bool HasActivity(CompanyResponse c) =>
        c.PrimaryIndustry is not null
        || c.EmployeeCount is not null
        || !string.IsNullOrWhiteSpace(c.SectorDescription);

    private static bool HasDates(CompanyResponse c) =>
        c.FoundingDate is not null
        || c.RegisteredDate is not null
        || c.RegisteredInVatRegistry is not null
        || c.RegisteredInBusinessRegistry is not null;

    // CountryDetector's open-API rule set rejects bare 8-digit Estonian codes (no checksum
    // signature in that bucket). Hint Estonian users to prefix EE so the dispatch hits
    // the Estonian provider instead of falling through to Unknown.
    private static bool LooksLikeEstonianFormat(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return false;
        var trimmed = input.Trim();
        return trimmed.Length == 8 && trimmed.All(char.IsDigit);
    }

    private bool _countryPickerOpen;

    private void SelectCountry(string? countryCode)
    {
        ViewModel.SelectedCountryHint = countryCode;
        _countryPickerOpen = false;
    }

    private static string? FormatAddress(PostalAddress a)
    {
        var parts = new[]
        {
            a.StreetAddress,
            string.Join(" ", new[] { a.PostalCode, a.City }.Where(p => !string.IsNullOrWhiteSpace(p))),
            a.Country,
        }.Where(p => !string.IsNullOrWhiteSpace(p));
        var joined = string.Join(", ", parts);
        return string.IsNullOrWhiteSpace(joined) ? null : joined;
    }

