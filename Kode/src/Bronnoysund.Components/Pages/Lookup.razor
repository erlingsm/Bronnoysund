@page "/"
@page "/lookup"
@using System.Globalization
@using Bronnoysund.Application.International
@inject CompanyLookupViewModel ViewModel
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Nav
@inject IDeviceLayout DeviceLayout
@inject ITextToSpeech TextToSpeech
@inject ISnackbar Snackbar
@inject ICountryDetector CountryDetector
@inject ICompanyProviderRegistry ProviderRegistry
@implements IDisposable

<PageTitle>@L["LookupTitle"]</PageTitle>

<MudContainer MaxWidth="@ContainerWidth" Class="mt-8">
    <MudText Typo="Typo.h4" GutterBottom="true">@L["LookupTitle"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        @L["LookupDescription"]
    </MudText>

    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudRadioGroup T="bool" Value="@ViewModel.IsNameSearchMode" ValueChanged="OnSearchModeChanged" Class="mb-4">
            <MudRadio T="bool" Value="@false">@L["SearchModeOrgNumber"]</MudRadio>
            <MudRadio T="bool" Value="@true">@L["SearchModeName"]</MudRadio>
        </MudRadioGroup>

        @if (!ViewModel.IsNameSearchMode)
        {
            <div class="d-flex align-center" style="gap: 0.5rem;">
                <MudTextField @bind-Value="ViewModel.OrgNumberInput"
                              Label="@L["OrgNumberLabel"]"
                              Placeholder="@L["OrgNumberPlaceholder"]"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              OnKeyDown="@OnOrgNumberKeyDown"
                              Disabled="@ViewModel.IsBusy"
                              Class="flex-grow-1" />
                <div style="position: relative;">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@ViewModel.IsBusy"
                               EndIcon="@Icons.Material.Filled.ArrowDropDown"
                               OnClick="@(() => _countryPickerOpen = !_countryPickerOpen)"
                               aria-label="@L["Country.Picker.Title"]" aria-haspopup="listbox"
                               aria-expanded="@(_countryPickerOpen ? "true" : "false")">
                        @if (ViewModel.SelectedCountryHint is null)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Small" Class="mr-1" />
                            <span>@L["Country.Picker.Auto"]</span>
                        }
                        else
                        {
                            <span style="font-size: 1.1rem;" class="mr-1" aria-hidden="true">@CountryDisplay.Flag(ViewModel.SelectedCountryHint)</span>
                            <span>@ViewModel.SelectedCountryHint</span>
                        }
                    </MudButton>
                    @if (_countryPickerOpen)
                    {
                        var status = ProviderRegistry.ConfigurationStatus;
                        var countries = ProviderRegistry.SupportedCountries.OrderBy(c => c).ToList();
                        var liveCount = countries.Count(c => status.GetValueOrDefault(c));
                        <div style="position: absolute; top: 100%; right: 0; z-index: 1000; min-width: 280px;">
                            <MudPaper Elevation="8" Class="mt-1" role="listbox">
                                <MudList T="string" Dense="true">
                                    <MudListItem T="string" OnClick="@(() => SelectCountry(null))">
                                        <div class="d-flex align-center" style="gap: 0.5rem;">
                                            <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Small" />
                                            <div class="flex-grow-1">
                                                <MudText Typo="Typo.body2">@L["Country.Picker.Auto"]</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Country.Picker.AutoDescription"]</MudText>
                                            </div>
                                        </div>
                                    </MudListItem>
                                    <MudDivider />
                                    @foreach (var code in countries)
                                    {
                                        var configured = status.GetValueOrDefault(code);
                                        var statusLabel = configured ? L["Country.Picker.StatusConfigured"] : L["Country.Picker.StatusNotConfigured"];
                                        <MudListItem T="string" OnClick="@(() => SelectCountry(code))">
                                            <div class="d-flex align-center" style="gap: 0.5rem;">
                                                <span style="font-size: 1.1rem;" aria-hidden="true">@CountryDisplay.Flag(code)</span>
                                                <MudText Typo="Typo.body2" Class="flex-grow-1">@L[$"Country.{code}"]</MudText>
                                                <span style="color: @(configured ? "#4caf50" : "#bdbdbd"); font-size: 0.8rem;"
                                                      title="@statusLabel" aria-label="@statusLabel">●</span>
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>
                                <MudDivider />
                                <div class="px-4 py-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @string.Format(CultureInfo.CurrentCulture, L["Country.Picker.Footer"], liveCount, countries.Count)
                                    </MudText>
                                </div>
                            </MudPaper>
                        </div>
                    }
                </div>
                <VoiceInputButton Disabled="@ViewModel.IsBusy"
                                  OnOrgNumberRecognized="OnVoiceOrgnr"
                                  OnNameRecognized="OnVoiceName"
                                  OnRecognitionFailed="OnVoiceFailed" />
            </div>
            @if (ViewModel.SelectedCountryHint is { } pickedCountry)
            {
                <div class="d-flex align-center mt-2" style="gap: 0.4rem;">
                    <span style="font-size: 1.2rem;" aria-hidden="true">@CountryDisplay.Flag(pickedCountry)</span>
                    <MudText Typo="Typo.body2" Color="Color.Primary">
                        @string.Format(CultureInfo.CurrentCulture, L["Country.SelectedManually"], L[$"Country.{pickedCountry}"])
                    </MudText>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(ViewModel.OrgNumberInput))
            {
                var detected = CountryDetector.Detect(ViewModel.OrgNumberInput);
                if (detected is not null)
                {
                    <div class="d-flex align-center mt-2" style="gap: 0.4rem;">
                        <span style="font-size: 1.2rem;" aria-hidden="true">@CountryDisplay.Flag(detected.CountryCode)</span>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @string.Format(CultureInfo.CurrentCulture, L["Country.Detected"], L[$"Country.{detected.CountryCode}"])
                        </MudText>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center mt-2" style="gap: 0.4rem;">
                        <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Color="Color.Warning" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Color="Color.Warning">@L["Country.UnknownFormat"]</MudText>
                    </div>
                }
                @* 8-digit input is structurally ambiguous between Danish CVR and Estonian registry
                   codes. Detector picks Denmark first; surface Estonia as a possible alternative
                   regardless of which bucket the detector landed in. *@
                @if (LooksLikeEstonianFormat(ViewModel.OrgNumberInput))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 ml-7">
                        @L["Country.EstoniaHint"]
                    </MudText>
                }
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" FullWidth="true"
                       Disabled="@ViewModel.IsBusy" OnClick="OnLookupClicked">
                @if (ViewModel.IsBusy)
                {
                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["Searching"]</span>
                }
                else
                {
                    <span>@L["SearchButton"]</span>
                }
            </MudButton>
        }
        else
        {
            <div class="d-flex align-center" style="gap: 0.5rem;">
                <MudTextField @bind-Value="ViewModel.NameQueryInput"
                              Label="@L["SearchByNameLabel"]"
                              Placeholder="@L["SearchByNamePlaceholder"]"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              OnKeyDown="@OnNameKeyDown"
                              Disabled="@ViewModel.IsBusy"
                              Class="flex-grow-1" />
                <VoiceInputButton Disabled="@ViewModel.IsBusy"
                                  OnOrgNumberRecognized="OnVoiceOrgnr"
                                  OnNameRecognized="OnVoiceName"
                                  OnRecognitionFailed="OnVoiceFailed" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" FullWidth="true"
                       Disabled="@ViewModel.IsBusy" OnClick="OnSearchClicked">
                @if (ViewModel.IsBusy)
                {
                    <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["Searching"]</span>
                }
                else
                {
                    <span>@L["SearchButtonName"]</span>
                }
            </MudButton>
        }
    </MudPaper>

    @if (ViewModel.ErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">@ViewModel.ErrorMessage</MudAlert>
    }

    @* Master-detail kicks in only when both panes have content AND the host can fit them
       side-by-side. Phones get the original linear stack so the small screen isn't split. *@
    @if (UseMasterDetail)
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" md="5">
                @RenderHitsPanel()
            </MudItem>
            <MudItem xs="12" md="7">
                @RenderFoundPanel()
            </MudItem>
        </MudGrid>
    }
    else
    {
        @if (ViewModel.SearchHits.Count > 0)
        {
            @RenderHitsPanel()
        }
        @if (ViewModel.Found is not null)
        {
            @RenderFoundPanel()
        }
    }
</MudContainer>

@code {
    private MaxWidth ContainerWidth => DeviceLayout.Current switch
    {
        DeviceLayoutKind.Phone => MaxWidth.Medium,
        DeviceLayoutKind.Tablet => MaxWidth.Large,
        _ => MaxWidth.ExtraLarge,
    };

    private bool UseMasterDetail =>
        DeviceLayout.Current != DeviceLayoutKind.Phone
        && ViewModel.SearchHits.Count > 0
        && ViewModel.Found is not null;

    private RenderFragment RenderHitsPanel() => __builder =>
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudTable Items="@ViewModel.SearchHits" Hover="true" Dense="true" OnRowClick="OnHitClicked" T="CompanySearchHit">
                <HeaderContent>
                    <MudTh>@L["OrgNumberLabel"]</MudTh>
                    <MudTh>@L["CompanyNameCol"]</MudTh>
                    <MudTh>@L["CompanyTypeCol", ""].Value.Replace(": ", "")</MudTh>
                    <MudTh>@L["PostalCityCol"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="hit">
                    <MudTd><code>@hit.OrganizationNumber</code></MudTd>
                    <MudTd>@hit.Name</MudTd>
                    <MudTd>@hit.OrganizationFormCode</MudTd>
                    <MudTd>@hit.PostalCity</MudTd>
                </RowTemplate>
            </MudTable>
            @if (ViewModel.SearchTotalElements > ViewModel.SearchHits.Count)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    @L["SearchPaginationHint", ViewModel.SearchHits.Count, ViewModel.SearchTotalElements]
                </MudText>
            }
        </MudPaper>
    };

    private RenderFragment RenderFoundPanel() => __builder =>
    {
        if (ViewModel.Found is not { } found)
        {
            return;
        }

        <MudPaper Class="pa-4 mb-3" Elevation="3">
            <div class="d-flex align-center justify-space-between mb-1">
                <MudText Typo="Typo.h5">@found.OrganizationName</MudText>
                @if (TextToSpeech.IsAvailable)
                {
                    <MudTooltip Text="@L["ReadAloudTooltip"]" Placement="Placement.Left">
                        <MudIconButton Icon="@Icons.Material.Filled.VolumeUp"
                                       Color="Color.Primary"
                                       OnClick="() => OnReadAloud(found)" />
                    </MudTooltip>
                }
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                <code>@found.OrganizationNumber</code> · @found.CompanyType@(string.Equals(found.LanguageForm, "Unknown", StringComparison.OrdinalIgnoreCase) ? "" : " · " + found.LanguageForm)
            </MudText>

            @if (ViewModel.Aggregated?.Bankruptcy is { IsBankrupt: true } bankruptcy)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">
                    @(bankruptcy.Declared is { } d
                        ? L["BankruptcyAlert", d.ToString("d", CultureInfo.CurrentUICulture)]
                        : L["BankruptcyAlertNoDate"])
                </MudAlert>
            }

            @if (ViewModel.VoluntaryOrganization is { } volOrg)
            {
                <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.VolunteerActivism" Class="mb-3">
                    <MudText Typo="Typo.body2">
                        <strong>@L["VoluntaryOrgBadge"]</strong> · @L["VoluntaryOrgStatusLabel"]: @volOrg.Status
                        @if (!string.IsNullOrWhiteSpace(volOrg.PrimaryIcnpoCategoryName))
                        {
                            <span> · @L["VoluntaryOrgCategoryLabel"]: @volOrg.PrimaryIcnpoCategoryName</span>
                        }
                        @if (volOrg.FirstRegisteredDate is { } firstReg)
                        {
                            <span> · @L["VoluntaryOrgFirstRegisteredLabel"]: @firstReg.ToString("d", CultureInfo.CurrentUICulture)</span>
                        }
                        @if (volOrg.ParticipatesInGrasrotandel)
                        {
                            <span> · @L["VoluntaryOrgGrasrot"]</span>
                        }
                    </MudText>
                </MudAlert>
            }

            @if (HasContact(found))
            {
                <MudText Typo="Typo.subtitle1" Class="mt-2 mb-1">@L["ContactSection"]</MudText>
                <MudList T="string" Dense="true">
                    @if (found.BusinessAddress is { } addr && FormatAddress(addr) is { } addrLine)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.LocationOn"
                                     Text="@($"{L["AddressLabel"]}: {addrLine}")" />
                    }
                    @if (!string.IsNullOrWhiteSpace(found.Website))
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Public"
                                     Text="@($"{L["WebsiteLabel"]}: {found.Website}")" />
                    }
                    @if (!string.IsNullOrWhiteSpace(found.Email))
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Email"
                                     Text="@($"{L["EmailLabel"]}: {found.Email}")" />
                    }
                    @if (!string.IsNullOrWhiteSpace(found.Phone))
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Phone"
                                     Text="@($"{L["PhoneLabel"]}: {found.Phone}")" />
                    }
                    @if (!string.IsNullOrWhiteSpace(found.MobilePhone))
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.PhoneIphone"
                                     Text="@($"{L["MobileLabel"]}: {found.MobilePhone}")" />
                    }
                </MudList>
            }

            @if (HasActivity(found))
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-1">@L["ActivitySection"]</MudText>
                <MudList T="string" Dense="true">
                    @if (found.PrimaryIndustry is { } industry)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Category"
                                     Text="@($"{L["IndustryLabel"]}: {industry.Code} — {industry.Description}")" />
                    }
                    @if (found.EmployeeCount is { } emp)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.People"
                                     Text="@($"{L["EmployeesLabel"]}: {emp}")" />
                    }
                    @if (!string.IsNullOrWhiteSpace(found.SectorDescription))
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.AccountBalance"
                                     Text="@($"{L["SectorLabel"]}: {found.SectorDescription}")" />
                    }
                </MudList>
            }

            @if (HasDates(found))
            {
                <MudText Typo="Typo.subtitle1" Class="mt-3 mb-1">@L["DatesSection"]</MudText>
                <MudList T="string" Dense="true">
                    @if (found.FoundingDate is { } founded)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Cake"
                                     Text="@($"{L["FoundingDateLabel"]}: {founded.ToString("d", CultureInfo.CurrentUICulture)}")" />
                    }
                    @if (found.RegisteredDate is { } reg)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.HowToReg"
                                     Text="@($"{L["RegisteredDateLabel"]}: {reg.ToString("d", CultureInfo.CurrentUICulture)}")" />
                    }
                    @if (found.RegisteredInVatRegistry is { } vat)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Receipt"
                                     Text="@($"{L["VatRegistryLabel"]}: {(vat ? L["YesValue"] : L["NoValue"])}")" />
                    }
                    @if (found.RegisteredInBusinessRegistry is { } biz)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Business"
                                     Text="@($"{L["BusinessRegistryLabel"]}: {(biz ? L["YesValue"] : L["NoValue"])}")" />
                    }
                </MudList>
            }

            @if (ViewModel.StatusMessage is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Success" Class="mt-3 d-block">
                    @ViewModel.StatusMessage
                </MudText>
            }

            @{
                var sourceCountry = CountryDetector.Detect(found.OrganizationNumber)?.CountryCode;
                var registryInfo = RegistryMetadata.For(sourceCountry);
            }
            @if (registryInfo is not null)
            {
                <MudDivider Class="mt-4 mb-2" />
                <div class="d-flex align-center" style="gap: 0.4rem;">
                    <span aria-hidden="true">@CountryDisplay.Flag(registryInfo.CountryCode)</span>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @string.Format(CultureInfo.CurrentCulture, L["Registry.Footer"], registryInfo.RegistryName, registryInfo.LicenceShort)
                    </MudText>
                </div>
            }
        </MudPaper>

        @if (ViewModel.Aggregated?.Roles is { Roles: var roles } && roles.Count > 0)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["RolesSection"]</MudText>
                <MudTable Items="@roles" Dense="true" Hover="true" T="Role">
                    <HeaderContent>
                        <MudTh>@L["RolesPerson"]</MudTh>
                        <MudTh>@L["RolesRoleType"]</MudTh>
                        <MudTh>@L["RolesBirthDate"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="role">
                        <MudTd>@role.PersonName</MudTd>
                        <MudTd>@role.RoleType</MudTd>
                        <MudTd>@(role.DateOfBirth?.ToString("d", CultureInfo.CurrentUICulture) ?? "")</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        @if (ViewModel.Aggregated?.SubUnits is { SubUnits: var subUnits } && subUnits.Count > 0)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    @L["SubUnitsSection"] (@subUnits.Count)
                </MudText>
                @* Each sub-unit row is a navigation link to /underenhet/{orgnr} (Plan 57, A-gap 1).
                   Using MudListItem's Href + OnClick avoids the full-circuit re-render that a
                   server-handled OnClick would trigger. *@
                <MudList T="string" Dense="true">
                    @foreach (var sub in subUnits)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.AccountTree"
                                     Href="@($"underenhet/{sub.OrganizationNumber}")"
                                     Text="@($"{sub.Name} — {sub.OrganizationNumber}")" />
                    }
                </MudList>
            </MudPaper>
        }

        @if (ViewModel.LegalRoles is { Holdings: var holdings } && holdings.Count > 0)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    @L["LegalRolesSection"] (@holdings.Count)
                </MudText>
                <MudTable Items="@FlattenHoldings(holdings)" Dense="true" Hover="true" T="LegalRoleRow">
                    <HeaderContent>
                        <MudTh>@L["LegalRolesColTarget"]</MudTh>
                        <MudTh>@L["LegalRolesColRoleType"]</MudTh>
                        <MudTh>@L["LegalRolesColStatus"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd>@row.TargetName <code class="ml-2">@row.TargetOrgNumber</code></MudTd>
                        <MudTd>@row.RoleDescription <code class="ml-2">@row.RoleCode</code></MudTd>
                        <MudTd>@LocalizedStatus(row)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        @if (ViewModel.Changes is { } changes && HasAnyChanges(changes))
        {
            <MudPaper Class="pa-4 mb-3" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@L["ChangesSection"]</MudText>
                <MudExpansionPanels MultiExpansion="true">
                    @RenderFeed(L["ChangesEntityFeed"], changes.EntityFeed)
                    @RenderFeed(L["ChangesSubUnitFeed"], changes.SubUnitFeed)
                    @RenderFeed(L["ChangesRoleFeed"], changes.RoleFeed)
                </MudExpansionPanels>
            </MudPaper>
        }

        @if (ViewModel.Aggregated?.Errors is { Count: > 0 } errors)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="2">
                <MudText Typo="Typo.subtitle1" Color="Color.Warning" Class="mb-2">
                    @L["RegistryErrorsSection"]
                </MudText>
                <MudList T="string" Dense="true">
                    @foreach (var err in errors)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Warning"
                                     Text="@L["RegistryErrorRow", err.RegistryName, err.Message]" />
                    }
                </MudList>
            </MudPaper>
        }

        @if (ViewModel.EnrichmentErrors is { Count: > 0 } enrichmentErrors)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="2">
                <MudText Typo="Typo.subtitle1" Color="Color.Warning" Class="mb-2">
                    @L["RegistryErrorsSection"]
                </MudText>
                <MudList T="string" Dense="true">
                    @foreach (var err in enrichmentErrors)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.Warning"
                                     Text="@L["RegistryErrorRow", err.RegistryName, err.Message]" />
                    }
                </MudList>
            </MudPaper>
        }
    };

    private RenderFragment RenderFeed(string title, EntityChangesFeed feed) => __builder =>
    {
        <MudExpansionPanel Text="@($"{title} ({feed.Changes.Count})")">
            @if (feed.ErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@L["ChangesFeedError", feed.ErrorMessage]</MudAlert>
            }
            else if (feed.Changes.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ChangesEmpty"]</MudText>
            }
            else
            {
                <MudTable Items="@feed.Changes" Dense="true" Hover="true" T="EntityChange">
                    <HeaderContent>
                        <MudTh>@L["ChangesColTimestamp"]</MudTh>
                        <MudTh>@L["ChangesColType"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="change">
                        <MudTd>@(change.Timestamp?.ToString("g", CultureInfo.CurrentUICulture) ?? "")</MudTd>
                        <MudTd>@change.ChangeType</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudExpansionPanel>
    };

    private static IEnumerable<LegalRoleRow> FlattenHoldings(IReadOnlyList<LegalRoleHolding> holdings) =>
        holdings.SelectMany(h => h.Roles.Select(r => new LegalRoleRow(
            TargetOrgNumber: h.OrganizationNumber,
            TargetName: h.Name,
            RoleCode: r.TypeCode,
            RoleDescription: r.TypeDescription,
            IsResigned: r.IsResigned,
            IsDeregistered: r.IsDeregistered)));

    private string LocalizedStatus(LegalRoleRow row) =>
        row.IsResigned ? L["LegalRolesStatusResigned"]
        : row.IsDeregistered ? L["LegalRolesStatusDeregistered"]
        : L["LegalRolesStatusActive"];

    private static bool HasAnyChanges(EntityChangesResponse changes) =>
        changes.EntityFeed.Changes.Count > 0 || changes.EntityFeed.ErrorMessage is not null
        || changes.SubUnitFeed.Changes.Count > 0 || changes.SubUnitFeed.ErrorMessage is not null
        || changes.RoleFeed.Changes.Count > 0 || changes.RoleFeed.ErrorMessage is not null;

    private sealed record LegalRoleRow(
        string TargetOrgNumber,
        string TargetName,
        string RoleCode,
        string RoleDescription,
        bool IsResigned,
        bool IsDeregistered);

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelChanged;
        DeviceLayout.LayoutChanged += OnLayoutChanged;

        // Deep-link support. Three shapes:
        //   ?orgnr=974760843            -> direct lookup, Found-only panel
        //   ?name=Statens+vegvesen      -> name-search, hits-only panel
        //   ?name=Statens+vegvesen&select=971032081
        //                               -> name-search then select that orgnr to drive the
        //                                  master-detail layout deterministically (useful for
        //                                  screenshots and for sharing a specific result row).
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var orgnr = query["orgnr"];
        var name = query["name"];
        var select = query["select"];

        if (!string.IsNullOrWhiteSpace(name))
        {
            ViewModel.IsNameSearchMode = true;
            ViewModel.NameQueryInput = name;
            await ViewModel.SearchByNameAsync(CancellationToken.None);

            if (!string.IsNullOrWhiteSpace(select))
            {
                var hit = ViewModel.SearchHits.FirstOrDefault(h => h.OrganizationNumber == select);
                if (hit is not null)
                {
                    await ViewModel.SelectHitAsync(hit, CancellationToken.None);
                }
            }
        }
        else if (!string.IsNullOrWhiteSpace(orgnr))
        {
            ViewModel.OrgNumberInput = orgnr;
            await ViewModel.LookupAsync(CancellationToken.None);
        }
    }

